COMPOSE_PROJECT_NAME=clean-magento
MAGENTO_VERSION=2.4.9
MAGENTO_IMAGE=clean-magento-php:local
NGINX_IMAGE=clean-magento-nginx:local
ERP_IMAGE=clean-magento-erp:local
WEB_PORT=8090
BASE_URL=http://localhost:8090/
PHPMYADMIN_PORT=8091
ERP_PORT=8092
RABBITMQ_PORT=15673
# Select redis or valkey for Magento cache AND sessions.
CACHE_ENGINE=valkey
DB_PASSWORD=
DB_ROOT_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=
ERP_API_TOKEN=
